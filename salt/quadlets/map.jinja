{#- -*- coding: utf-8 -*- #}
{#- vim: ft=jinja #}
{#-
  Merges defaults.yaml with pillar, validates it and normalizes everything the
  states and the unit template need. Exports:

    quadlet       merged settings
    q_marker      header line written into every managed unit file
    q_network     {name, file, service, sections}
    q_apps        normalized apps that should exist
    q_absent      normalized apps marked `absent: true`
    q_expected    paths (relative to config_dir) of all unit files this
                  formula currently owns
    q_app_dirs    names of the per-app subdirectories that should exist

  An app is one quadlet: a subdirectory <config_dir>/<app>/ holding its
  .container units, its .volume units and, with more than one container, a
  .pod unit the containers join.

  Invalid pillar aborts rendering with a list of every problem found, so a
  broken pillar never gets half-applied.
#}
{%- import_yaml tpldir ~ '/defaults.yaml' as defaults %}
{%- set quadlet = salt['slsutil.merge'](defaults.quadlets, salt['pillar.get']('quadlets', {}), merge_lists=False) %}
{%- set q_marker = '# Managed by Salt (quadlet formula) - local changes will be overwritten' %}
{%- set config_dir = quadlet.config_dir | string %}
{%- set name_re = '^[A-Za-z0-9][A-Za-z0-9_.-]*$' %}
{%- set unit_re = '.*\\.(container|volume|network|pod)$' %}
{%- set errors = [] %}
{%- set seen = {'ip': {}, 'ip6': {}, 'mac': {}, 'service': {}, 'secret': {}} %}

{#- Append `Key=value` pairs from a mapping; list values repeat the key. #}
{%- macro add_pairs(pairs, data) %}
{%-   for key, value in (data or {}).items() %}
{%-     set items = [value] if (value is string or value is number or value is mapping) else (value if value is not none else []) %}
{%-     for item in items %}
{%-       if item is sameas true %}{%- do pairs.append([key | string, 'true']) %}
{%-       elif item is sameas false %}{%- do pairs.append([key | string, 'false']) %}
{%-       elif item is not none %}{%- do pairs.append([key | string, item | string]) %}
{%-       endif %}
{%-     endfor %}
{%-   endfor %}
{%- endmacro %}

{#- Capitalized keys in a config mapping are raw unit sections ([Unit], [Service], ...). #}
{%- macro merge_sections(sections, cfg) %}
{%-   for key, value in cfg.items() if (key | string)[:1].isupper() %}
{%-     if key not in sections %}{%- do sections.update({key: []}) %}{%- endif %}
{%-     do add_pairs(sections[key], value) %}
{%-   endfor %}
{%- endmacro %}

{#- "KEY=value" quoted for Environment=/Label=; % and $ escaped so values stay literal. #}
{%- macro kv_quote(key, value) -%}
{%-   set value = 'true' if value is sameas true else ('false' if value is sameas false else value) -%}
"{{ (key ~ '=' ~ value) | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"
{%- endmacro %}

{#- Unit names are global across all subdirectories; record one or report the clash. #}
{%- macro claim_service(service, owner) %}
{%-   if service in seen.service %}
{%-     do errors.append(owner ~ ': service ' ~ service ~ ' is already generated by ' ~ seen.service[service]) %}
{%-   endif %}
{%-   do seen.service.update({service: owner}) %}
{%- endmacro %}

{#- ------------------------------------------------------------------ network #}
{%- set net = quadlet.network %}
{%- set net_name = net.name | string %}
{%- set subnets = [net.subnet] if net.subnet is string else (net.subnet or []) %}
{%- set gateways = [net.gateway] if net.gateway is string else (net.gateway or []) %}
{%- set ip_ranges = [net.ip_range] if net.ip_range is string else (net.ip_range or []) %}

{%- if net_name | regex_match(name_re) is none %}
{%-   do errors.append('network:name "' ~ net_name ~ '" is not a valid unit/network name') %}
{%- endif %}
{%- if not net.parent %}
{%-   do errors.append('network:parent is required (host interface the macvlan sits on, e.g. eth0)') %}
{%- endif %}
{%- if not subnets %}
{%-   do errors.append('network:subnet is required (static IPs need a subnet)') %}
{%- endif %}

{%- set net_pairs = [['NetworkName', net_name], ['Driver', net.driver | string]] %}
{%- if net.parent %}{%- do net_pairs.append(['Options', 'parent=' ~ net.parent]) %}{%- endif %}
{%- if net.mode %}{%- do net_pairs.append(['Options', 'mode=' ~ net.mode]) %}{%- endif %}
{%- for key, value in (net.options or {}).items() %}
{%-   do net_pairs.append(['Options', key ~ '=' ~ value]) %}
{%- endfor %}
{%- for s in subnets %}{%- do net_pairs.append(['Subnet', s | string]) %}{%- endfor %}
{%- for g in gateways %}{%- do net_pairs.append(['Gateway', g | string]) %}{%- endfor %}
{%- for r in ip_ranges %}{%- do net_pairs.append(['IPRange', r | string]) %}{%- endfor %}
{%- if net.ipv6 %}{%- do net_pairs.append(['IPv6', 'true']) %}{%- endif %}

{%- set net_sections = {'Unit': [], 'Network': net_pairs} %}
{%- if 'Description' not in (net.get('Unit') or {}) %}
{%-   do net_sections.Unit.append(['Description', net.driver ~ ' network ' ~ net_name ~ ' on ' ~ net.parent]) %}
{%- endif %}
{%- do merge_sections(net_sections, net) %}
{%- set q_network = {
      'name': net_name,
      'file': config_dir ~ '/' ~ net_name ~ '.network',
      'service': ((net.get('Network') or {}).get('ServiceName') or (net_name ~ '-network')) ~ '.service',
      'sections': net_sections.items() | list,
    } %}
{%- set q_expected = [net_name ~ '.network'] %}
{%- set q_app_dirs = [] %}
{%- do seen.service.update({q_network.service: 'network'}) %}

{#- --------------------------------------------------------------------- apps #}
{%- set app_keys = [
      'description', 'pod', 'hostname', 'ip', 'ip6', 'mac', 'dns',
      'volumes', 'secrets', 'containers', 'running', 'enabled',
      'absent', 'purge_volumes',
    ] %}
{%- set container_keys = [
      'image', 'description', 'container_name',
      'environment', 'environment_files', 'labels',
      'command', 'entrypoint', 'user', 'group', 'auto_update',
      'volumes', 'pull',
    ] %}
{#- [Container] keys that belong to the pod once the containers share one #}
{%- set pod_owned_keys = ['Network', 'IP', 'IP6', 'HostName', 'DNS', 'PublishPort', 'Pod'] %}
{%- set q_apps = [] %}
{%- set q_absent = [] %}

{%- for aname, raw_app in (quadlet.apps or {}).items() %}
{%-   set app_name = aname | string %}
{%-   set a = raw_app or {} %}
{%-   set where = 'apps:' ~ app_name %}
{%-   set is_absent = a.get('absent', false) %}
{%-   set app_dir = config_dir ~ '/' ~ app_name %}

{%-   if app_name | regex_match(name_re) is none %}
{%-     do errors.append(where ~ ': name may only contain letters, digits, ".", "_" and "-"') %}
{%-   endif %}
{%-   for key in a if not (key | string)[:1].isupper() and key not in app_keys %}
{%-     if key in container_keys %}
{%-       do errors.append(where ~ ': "' ~ key ~ '" is set per container (apps:' ~ app_name ~ ':containers:<name>:' ~ key ~ ')') %}
{%-     else %}
{%-       do errors.append(where ~ ': unknown option "' ~ key ~ '"') %}
{%-     endif %}
{%-   endfor %}

{%-   set containers_raw = a.get('containers') or {} %}
{%-   if containers_raw is not mapping %}
{%-     do errors.append(where ~ ': containers must be a mapping of container name to settings') %}
{%-     set containers_raw = {} %}
{%-   endif %}
{%-   if not is_absent and not containers_raw %}
{%-     do errors.append(where ~ ': at least one container is required') %}
{%-   endif %}

{%-   set pod_opt = a.get('pod', 'auto') %}
{%-   if not (pod_opt is sameas true or pod_opt is sameas false or pod_opt == 'auto') %}
{%-     do errors.append(where ~ ': pod must be auto, true or false') %}
{%-   endif %}
{%-   set use_pod = pod_opt is sameas true or (pod_opt == 'auto' and containers_raw | length > 1) %}
{%-   if not use_pod and containers_raw | length > 1 %}
{%-     do errors.append(where ~ ': pod: false needs exactly one container (all containers of an app share its ip/mac)') %}
{%-   endif %}
{%-   if not use_pod %}
{%-     for key in a if (key | string)[:1].isupper() %}
{%-       do errors.append(where ~ ': raw section "' ~ key ~ '" on the app only applies to a pod; put it under the container instead') %}
{%-     endfor %}
{%-   endif %}

{#-   --- network attachment of the pod (or the single container): static IPv4 / IPv6 / MAC #}
{%-   set netopts = [] %}
{%-   set ip = a.get('ip') %}
{%-   if ip is not none %}
{%-     set ip = ip | string %}
{%-     if not (ip | is_ipv4) %}
{%-       do errors.append(where ~ ': ip "' ~ ip ~ '" is not a valid IPv4 address') %}
{%-     else %}
{%-       set hits = [] %}
{%-       for s in subnets %}
{%-         if salt['network.ip_in_subnet'](ip, s | string) %}{%- do hits.append(s) %}{%- endif %}
{%-       endfor %}
{%-       if subnets and not hits %}
{%-         do errors.append(where ~ ': ip ' ~ ip ~ ' is not inside network subnet(s) ' ~ subnets | join(', ')) %}
{%-       endif %}
{%-       if ip in gateways %}
{%-         do errors.append(where ~ ': ip ' ~ ip ~ ' is the network gateway') %}
{%-       endif %}
{%-       if not is_absent %}
{%-         if ip in seen.ip %}
{%-           do errors.append(where ~ ': ip ' ~ ip ~ ' is already used by ' ~ seen.ip[ip]) %}
{%-         endif %}
{%-         do seen.ip.update({ip: app_name}) %}
{%-       endif %}
{%-     endif %}
{%-     do netopts.append('ip=' ~ ip) %}
{%-   endif %}

{%-   set ip6 = a.get('ip6') %}
{%-   if ip6 is not none %}
{%-     set ip6 = ip6 | string %}
{%-     if not (ip6 | is_ipv6) %}
{%-       do errors.append(where ~ ': ip6 "' ~ ip6 ~ '" is not a valid IPv6 address') %}
{%-     elif not is_absent %}
{%-       if ip6 in seen.ip6 %}
{%-         do errors.append(where ~ ': ip6 ' ~ ip6 ~ ' is already used by ' ~ seen.ip6[ip6]) %}
{%-       endif %}
{%-       do seen.ip6.update({ip6: app_name}) %}
{%-     endif %}
{%-     do netopts.append('ip6=' ~ ip6) %}
{%-   endif %}

{%-   set mac = a.get('mac') %}
{%-   if mac == 'auto' %}
{%-     if ip is not none and ip | is_ipv4 %}
{%-       set o = ip.split('.') | map('int') | list %}
{%-       set mac = '02:42:%02x:%02x:%02x:%02x' | format(o[0], o[1], o[2], o[3]) %}
{%-     else %}
{%-       do errors.append(where ~ ': mac "auto" needs a valid ip to derive the address from') %}
{%-       set mac = none %}
{%-     endif %}
{%-   endif %}
{%-   if mac is not none %}
{%-     if mac is not string %}
{%-       do errors.append(where ~ ': mac must be a quoted string (unquoted YAML may turn e.g. 12:34:56:00:11:22 into a number)') %}
{%-     elif mac | regex_match('^([0-9a-f]{2}:){5}[0-9a-f]{2}$', ignorecase=True) is none %}
{%-       do errors.append(where ~ ': mac "' ~ mac ~ '" is not of the form 02:00:00:00:00:01') %}
{%-     else %}
{%-       set mac = mac | lower %}
{%-       if (mac[:2] | int(0, 16)) % 2 == 1 %}
{%-         do errors.append(where ~ ': mac ' ~ mac ~ ' is a multicast address (first octet must be even; use a locally administered x2/x6/xA/xE prefix)') %}
{%-       endif %}
{%-       if not is_absent %}
{%-         if mac in seen.mac %}
{%-           do errors.append(where ~ ': mac ' ~ mac ~ ' is already used by ' ~ seen.mac[mac]) %}
{%-         endif %}
{%-         do seen.mac.update({mac: app_name}) %}
{%-       endif %}
{%-       do netopts.append('mac=' ~ mac) %}
{%-     endif %}
{%-   endif %}

{%-   set network_spec = net_name ~ '.network' ~ ((':' ~ netopts | join(',')) if netopts else '') %}
{%-   set hostname = a.get('hostname', app_name) %}
{%-   set dns = a.get('dns') %}
{%-   set dns = [dns] if dns is string else (dns or []) %}

{#-   --- named volumes, shared by every container of the app #}
{%-   set vols = {} %}
{%-   set vdefs = a.get('volumes') or {} %}
{%-   if vdefs is not mapping %}
{%-     do errors.append(where ~ ': volumes must be a mapping of volume name to settings (mounts go under containers:<name>:volumes)') %}
{%-     set vdefs = {} %}
{%-   endif %}
{%-   for vkey, vraw in vdefs.items() %}
{%-     set vname = vkey | string %}
{%-     set v = vraw or {} %}
{%-     set vwhere = where ~ ':volumes:' ~ vname %}
{%-     if vname | regex_match(name_re) is none %}
{%-       do errors.append(vwhere ~ ': volume name is invalid') %}
{%-     endif %}
{%-     if v is not mapping %}
{%-       do errors.append(vwhere ~ ': settings must be a mapping') %}
{%-       set v = {} %}
{%-     endif %}
{%-     for key in v if not (key | string)[:1].isupper() and key != 'volume_name' %}
{%-       do errors.append(vwhere ~ ': unknown option "' ~ key ~ '" (raw keys go under Volume:/Unit:)') %}
{%-     endfor %}
{%-     set vunit = app_name ~ '-' ~ vname %}
{%-     set vol_name = (v.get('volume_name') or vunit) | string %}
{%-     if not is_absent %}
{%-       do claim_service(((v.get('Volume') or {}).get('ServiceName') or (vunit ~ '-volume')) ~ '.service', vwhere) %}
{%-     endif %}
{%-     set vsections = {'Unit': [], 'Volume': [['VolumeName', vol_name]]} %}
{%-     if 'Description' not in (v.get('Unit') or {}) %}
{%-       do vsections.Unit.append(['Description', 'Podman volume ' ~ vol_name ~ ' for ' ~ app_name]) %}
{%-     endif %}
{%-     do merge_sections(vsections, v) %}
{%-     do vols.update({vname: {
          'name': vname,
          'unit': vunit,
          'rel': app_name ~ '/' ~ vunit ~ '.volume',
          'file': app_dir ~ '/' ~ vunit ~ '.volume',
          'volume_name': vol_name,
          'sections': vsections.items() | list,
        }}) %}
{%-   endfor %}

{#-   --- podman secrets (global names); values never go into an error message #}
{%-   set secrets = [] %}
{%-   set sdefs = a.get('secrets') or {} %}
{%-   if sdefs is not mapping %}
{%-     do errors.append(where ~ ': secrets must be a mapping of podman secret name to value') %}
{%-     set sdefs = {} %}
{%-   endif %}
{%-   for skey, sval in sdefs.items() %}
{%-     set sname = skey | string %}
{%-     set swhere = where ~ ':secrets:' ~ sname %}
{%-     if sname | regex_match(name_re) is none %}
{%-       do errors.append(swhere ~ ': secret name is invalid') %}
{%-     endif %}
{%-     if not is_absent %}
{%-       if not (sval is string or sval is number) or sval is sameas true or sval is sameas false %}
{%-         do errors.append(swhere ~ ': value must be a string') %}
{%-       elif sval | string == '' %}
{%-         do errors.append(swhere ~ ': value is empty; refusing to replace the secret with an empty one') %}
{%-       endif %}
{%-       if sname in seen.secret %}
{%-         do errors.append(swhere ~ ': secret ' ~ sname ~ ' is already defined by ' ~ seen.secret[sname]) %}
{%-       endif %}
{%-       do seen.secret.update({sname: where}) %}
{%-     endif %}
{%-     do secrets.append({'name': sname, 'value': sval | string if sval is not none else none}) %}
{%-   endfor %}

{#-   --- pod #}
{%-   set pod = none %}
{%-   if use_pod %}
{%-     set pod_cfg = salt['slsutil.merge'](quadlet.pod_defaults, a, merge_lists=False) %}
{%-     set ppairs = [['PodName', app_name], ['Network', network_spec]] %}
{#-     PodmanArgs instead of HostName=/DNS=, which older .pod units lack #}
{%-     if hostname %}{%- do ppairs.append(['PodmanArgs', '--hostname=' ~ hostname]) %}{%- endif %}
{%-     for d in dns %}{%- do ppairs.append(['PodmanArgs', '--dns=' ~ d]) %}{%- endfor %}
{%-     set psections = {'Unit': [], 'Pod': ppairs} %}
{%-     if 'Description' not in (pod_cfg.get('Unit') or {}) %}
{%-       do psections.Unit.append(['Description', (a.get('description') or ('Podman pod ' ~ app_name)) | string]) %}
{%-     endif %}
{%-     do merge_sections(psections, pod_cfg) %}
{%-     set install = psections.pop('Install', none) %}
{%-     if install and a.get('enabled', true) %}{%- do psections.update({'Install': install}) %}{%- endif %}
{%-     set pod = {
          'unit': app_name,
          'rel': app_name ~ '/' ~ app_name ~ '.pod',
          'file': app_dir ~ '/' ~ app_name ~ '.pod',
          'service': ((pod_cfg.get('Pod') or {}).get('ServiceName') or (app_name ~ '-pod')) ~ '.service',
          'sections': psections.items() | list,
        } %}
{%-     if not is_absent %}{%- do claim_service(pod.service, where) %}{%- endif %}
{%-   endif %}

{#-   --- containers #}
{%-   set containers = [] %}
{%-   for ckey, craw in containers_raw.items() %}
{%-     set cname = ckey | string %}
{%-     set c = salt['slsutil.merge'](quadlet.container_defaults, craw or {}, merge_lists=False) %}
{%-     set cwhere = where ~ ':containers:' ~ cname %}
{%-     set stem = app_name if cname == app_name else app_name ~ '-' ~ cname %}

{%-     if cname | regex_match(name_re) is none %}
{%-       do errors.append(cwhere ~ ': name may only contain letters, digits, ".", "_" and "-"') %}
{%-     endif %}
{%-     for key in c if not (key | string)[:1].isupper() and key not in container_keys %}
{%-       if key in app_keys %}
{%-         do errors.append(cwhere ~ ': "' ~ key ~ '" is set on the app (apps:' ~ app_name ~ ':' ~ key ~ '), not on a container') %}
{%-       else %}
{%-         do errors.append(cwhere ~ ': unknown option "' ~ key ~ '" (raw unit keys go under Container:/Unit:/Service:/Install:)') %}
{%-       endif %}
{%-     endfor %}
{%-     if not is_absent and not c.get('image') %}
{%-       do errors.append(cwhere ~ ': image is required') %}
{%-     endif %}
{%-     if use_pod %}
{%-       for key in (c.get('Container') or {}) if key in pod_owned_keys %}
{%-         do errors.append(cwhere ~ ': Container:' ~ key ~ ' is not allowed in a pod; the pod owns network, hostname, DNS and ports (set them on the app or under apps:' ~ app_name ~ ':Pod:)') %}
{%-       endfor %}
{%-     endif %}

{%-     set cpairs = [
          ['ContainerName', (c.get('container_name') or stem) | string],
          ['Image', (c.get('image') or '') | string],
        ] %}
{%-     if use_pod %}
{%-       do cpairs.append(['Pod', app_name ~ '.pod']) %}
{%-     else %}
{%-       if hostname %}{%- do cpairs.append(['HostName', hostname | string]) %}{%- endif %}
{%-       do cpairs.append(['Network', network_spec]) %}
{%-       for d in dns %}{%- do cpairs.append(['DNS', d | string]) %}{%- endfor %}
{%-     endif %}
{%-     for key, value in (c.get('environment') or {}).items() %}
{%-       do cpairs.append(['Environment', kv_quote(key, value)]) %}
{%-     endfor %}
{%-     set envf = c.get('environment_files') %}
{%-     for f in ([envf] if envf is string else (envf or [])) %}{%- do cpairs.append(['EnvironmentFile', f | string]) %}{%- endfor %}
{%-     for key, value in (c.get('labels') or {}).items() %}
{%-       do cpairs.append(['Label', kv_quote(key, value)]) %}
{%-     endfor %}

{#-     --- mounts: app volume, host path (bind) or raw string #}
{%-     set uses = [] %}
{%-     set bind_dirs = [] %}
{%-     for m in (c.get('volumes') or []) %}
{%-       if m is string %}
{%-         do cpairs.append(['Volume', m]) %}
{%-       elif m is mapping %}
{%-         set target = m.get('target') %}
{%-         set opts = m.get('options') %}
{%-         set optstr = opts if opts is string else ((opts or []) | join(',')) %}
{%-         set spec = none %}
{%-         if not target or not (target | string).startswith('/') %}
{%-           do errors.append(cwhere ~ ': every volume needs an absolute target (got ' ~ m | json ~ ')') %}
{%-         endif %}
{%-         if m.get('name') %}
{%-           do errors.append(cwhere ~ ': volume ' ~ m | json ~ ' uses "name"; define it under apps:' ~ app_name ~ ':volumes and mount it with "volume:"') %}
{%-         elif m.get('volume') and m.get('source') %}
{%-           do errors.append(cwhere ~ ': volume ' ~ m | json ~ ' has both volume and source; use one') %}
{%-         elif m.get('volume') %}
{%-           set vref = m.volume | string %}
{%-           if vref not in vols %}
{%-             do errors.append(cwhere ~ ': volume "' ~ vref ~ '" is not defined under apps:' ~ app_name ~ ':volumes') %}
{%-           else %}
{%-             if vols[vref] not in uses %}{%- do uses.append(vols[vref]) %}{%- endif %}
{%-             set spec = vols[vref].unit ~ '.volume:' ~ target %}
{%-           endif %}
{%-         elif m.get('source') %}
{%-           set source = m.source | string %}
{%-           if not source.startswith('/') %}
{%-             do errors.append(cwhere ~ ': bind source "' ~ source ~ '" must be an absolute path') %}
{%-           endif %}
{%-           if m.get('create', true) and not salt['file.file_exists'](source) %}
{%-             do bind_dirs.append({
                  'path': source,
                  'user': m.get('user'),
                  'group': m.get('group'),
                  'mode': m.get('mode'),
                }) %}
{%-           endif %}
{%-           set spec = source ~ ':' ~ target %}
{%-         else %}
{%-           do errors.append(cwhere ~ ': volume ' ~ m | json ~ ' needs either volume (app volume) or source (host path)') %}
{%-         endif %}
{%-         if spec %}
{%-           do cpairs.append(['Volume', spec ~ ((':' ~ optstr) if optstr else '')]) %}
{%-         endif %}
{%-       else %}
{%-         do errors.append(cwhere ~ ': volumes entries must be strings or mappings') %}
{%-       endif %}
{%-     endfor %}

{#-     --- app secrets this container references through Container:Secret #}
{%-     set suses = [] %}
{%-     set raw_secrets = (c.get('Container') or {}).get('Secret') %}
{%-     for s in ([raw_secrets] if raw_secrets is string else (raw_secrets or [])) %}
{%-       set sref = (s | string).split(',')[0] %}
{%-       for sec in secrets if sec.name == sref and sec not in suses %}{%- do suses.append(sec) %}{%- endfor %}
{%-     endfor %}

{%-     if c.get('entrypoint') %}{%- do cpairs.append(['Entrypoint', c.entrypoint | string]) %}{%- endif %}
{%-     if c.get('command') %}{%- do cpairs.append(['Exec', c.command | string]) %}{%- endif %}
{%-     if c.get('user') is not none %}{%- do cpairs.append(['User', c.user | string]) %}{%- endif %}
{%-     if c.get('group') is not none %}{%- do cpairs.append(['Group', c.group | string]) %}{%- endif %}
{%-     if c.get('auto_update') %}{%- do cpairs.append(['AutoUpdate', c.auto_update | string]) %}{%- endif %}

{#-     --- assemble sections: Unit, Container, raw sections..., Install last #}
{%-     set sections = {'Unit': [], 'Container': cpairs} %}
{%-     if 'Description' not in (c.get('Unit') or {}) %}
{%-       set default_desc = a.get('description') if not use_pod else none %}
{%-       do sections.Unit.append(['Description', (c.get('description') or default_desc or ('Podman container ' ~ stem)) | string]) %}
{%-     endif %}
{%-     do merge_sections(sections, c) %}
{%-     set install = sections.pop('Install', none) %}
{%-     if install and a.get('enabled', true) %}{%- do sections.update({'Install': install}) %}{%- endif %}

{%-     set image = (c.get('image') or '') | string %}
{%-     set container = {
          'name': cname,
          'unit': stem,
          'rel': app_name ~ '/' ~ stem ~ '.container',
          'file': app_dir ~ '/' ~ stem ~ '.container',
          'service': ((c.get('Container') or {}).get('ServiceName') or stem) ~ '.service',
          'image': image,
          'pull': quadlet.pull_images and c.get('pull', true) and image and not (image.endswith('.image') or image.endswith('.build')),
          'sections': sections.items() | list,
          'volumes': uses,
          'secrets': suses,
          'bind_dirs': bind_dirs,
        } %}
{%-     if not is_absent %}{%- do claim_service(container.service, cwhere) %}{%- endif %}
{%-     do containers.append(container) %}
{%-   endfor %}

{%-   set app = {
        'name': app_name,
        'dir': app_dir,
        'pod': pod,
        'containers': containers,
        'volumes': vols.values() | list,
        'secrets': secrets,
        'running': a.get('running', true),
        'purge_volumes': a.get('purge_volumes', false),
      } %}
{%-   if is_absent %}
{%-     do q_absent.append(app) %}
{%-   else %}
{%-     do q_apps.append(app) %}
{%-     do q_app_dirs.append(app_name) %}
{%-     if pod %}{%- do q_expected.append(pod.rel) %}{%- endif %}
{%-     for x in containers + app.volumes %}{%- do q_expected.append(x.rel) %}{%- endfor %}
{%-   endif %}
{%- endfor %}

{#- A hand-written unit with the same file name anywhere under config_dir would
    collide with ours (quadlet unit names are global across subdirectories). #}
{%- if salt['file.directory_exists'](config_dir) %}
{%-   set expected_by_base = {} %}
{%-   for rel in q_expected %}{%- do expected_by_base.update({rel.split('/')[-1]: rel}) %}{%- endfor %}
{%-   for path in salt['file.find'](config_dir, type='f', maxdepth=2, regex=unit_re) | sort %}
{%-     set rel = path[config_dir | length + 1:] %}
{%-     set base = rel.split('/')[-1] %}
{%-     if base in expected_by_base and rel != expected_by_base[base] and not salt['file.search'](path, '^' ~ q_marker | regex_escape) %}
{%-       do errors.append('unit ' ~ base ~ ' would be written to ' ~ config_dir ~ '/' ~ expected_by_base[base] ~ ', but a hand-written ' ~ path ~ ' already exists; remove it first') %}
{%-     endif %}
{%-   endfor %}
{%- endif %}

{%- if errors %}
{{-   raise('Invalid quadlets pillar:\n  - ' ~ errors | join('\n  - ')) }}
{%- endif %}
