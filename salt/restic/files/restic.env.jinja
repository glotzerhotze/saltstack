# Managed by Salt (restic formula) - local changes will be overwritten.
# Sourced by run-backup and restic-repo.
export RESTIC_REPOSITORY={{ restic.repository | quote }}
export RESTIC_PASSWORD_FILE={{ restic.password_file | quote }}
{%- for key, value in restic.client.env | dictsort %}
export {{ key }}={{ value | string | quote }}
{%- endfor %}
